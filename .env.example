# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=https://app.solinebtp.fr
NEXT_PUBLIC_MARKETING_URL=https://solinebtp.fr

# Notifications push (Web Push / PWA) — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@solinebtp.fr

# Cron (Vercel)
CRON_SECRET=

# Plateforme Agréée — facturation électronique B2B
# noop | pennylane | http | docaposte | confactura | superpdp
# (docaposte/confactura/superpdp = alias de "http", juste pour des logs lisibles ; voir
# integrations.md §2 — Super PDP recommandé Vague 6 : immatriculé PDP, tarif au volume
# ~0,0025€/facture, pas d'abonnement minimum trouvé publiquement)
PA_PROVIDER=noop
PA_API_KEY=
# Optionnel — Pennylane utilise l'URL par défaut si vide ; obligatoire pour http/docaposte/confactura/superpdp
PA_API_URL=
PA_WEBHOOK_SECRET=
PA_RETRY_ATTEMPTS=3

# E-reporting B2C (transmission groupée)
# noop | http (réutilise PA_API_KEY si E_REPORTING_API_KEY absent)
E_REPORTING_PROVIDER=
E_REPORTING_API_URL=
E_REPORTING_API_KEY=

# Factur-X — validation (1 = désactivé)
FACTURX_SKIP_SCHEMATRON=
FACTURX_SKIP_STACKFORGE=
FACTURX_SKIP_STAFYNAKSA=

# Recouvrement — mise en demeure LRAR papier (MySendingBox / La Poste)
# Clé API utilisée en Auth Basic (la clé sert d'identifiant, sans mot de passe)
MYSENDINGBOX_API_KEY=
# MySendingBox ne signe pas ses callbacks : secret partagé transmis dans
# l'en-tête `x-webhook-secret` ou en paramètre `?secret=` de l'URL de callback
MYSENDINGBOX_WEBHOOK_SECRET=

# Recouvrement — dossiers de créance (RubyPayeur)
RUBYPAYEUR_API_URL=
RUBYPAYEUR_API_KEY=
RUBYPAYEUR_WEBHOOK_SECRET=
# Identifiant partenaire apporteur d'affaires
RUBYPAYEUR_PARTNER_ID=
# Rétrocession sur les honoraires RubyPayeur (0.2 = 20 %, valeur par défaut)
RUBYPAYEUR_COMMISSION_RATE=0.2

# IA — Mistral (assistant, métré devis, leads)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=

# Voix — agent vocal (Twilio + ElevenLabs)
# Token d'authentification Twilio, utilisé pour vérifier la signature des
# webhooks entrants (ex. statut d'appel). Sans lui, le endpoint refuse la requête.
TWILIO_AUTH_TOKEN=
# URL publique du webhook de statut d'appel, si différente de celle déduite
# automatiquement de la requête (utile derrière un proxy/tunnel).
TWILIO_STATUS_CALLBACK_URL="https://app.solinebtp.fr/api/webhooks/twilio/status"
# Secret partagé attendu par les endpoints "tool calling" appelés par l'agent
# vocal ElevenLabs (ex. lookup client, création de devis depuis un appel).
VOICE_AI_TOOL_SECRET=
# Secret HMAC du webhook post-appel ElevenLabs (ElevenAgents > Settings > Post-call webhook).
# Route : POST /api/webhooks/elevenlabs/post-call — chaque appel finit dans /app/appels.
ELEVENLABS_WEBHOOK_SECRET=
# SMS de confirmation au client quand l'artisan valide un RDV pris par Soline.
# Numéro Twilio compatible SMS (E.164) ou identifiant alphanumérique (ex. Soline). Sans valeur : pas de SMS.
TWILIO_SMS_FROM=

# Provisionnement automatique des numéros Soline (Admin > Télécom > Pool, cron voice-pool-refill)
TWILIO_ACCOUNT_SID=
# Dossier réglementaire FR approuvé dans Twilio (Regulatory Compliance > Bundles) + adresse associée
TWILIO_FR_BUNDLE_SID=
TWILIO_FR_ADDRESS_SID=
# local (01-05), national (09) ou mobile — selon le dossier approuvé
TWILIO_FR_NUMBER_TYPE=local
# Clé API Twilio transmise à ElevenLabs à l'import (sinon SID + token du compte)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Réassort auto : désactivé tant que VOICE_POOL_AUTO_REFILL != true
VOICE_POOL_AUTO_REFILL=false
VOICE_POOL_MIN_AVAILABLE=2
VOICE_POOL_TARGET_AVAILABLE=4
VOICE_POOL_MAX_TOTAL=30
VOICE_POOL_MAX_PER_RUN=5

# Recherche web pour métré devis (optionnel — Tavily)
# Sans clé : le métré repose sur le LLM + normes BTP courantes
TAVILY_API_KEY=

# Email (Resend)
# Sans clé : les emails sont loggés en console (mode dev), aucun envoi réel.
RESEND_API_KEY=
# Adresse d'expédition ; défaut si vide : "Soline <noreply@solinebtp.fr>"
EMAIL_FROM="Support Soline <support@solinebtp.fr>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tarif ambassadeur (migration 30) : coupon percent_off=25, duration=forever,
# applies_to = produits Pro + Premium. Sans lui, le checkout ambassadeur est refusé
# (jamais de bascule silencieuse au plein tarif).
STRIPE_AMBASSADOR_COUPON_ID=
# Optionnel : Price IDs explicites (sinon déduits des Payment Links ci-dessous).
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_PREMIUM_MONTHLY=
# STRIPE_PRICE_PREMIUM_ANNUAL=
